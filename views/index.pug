html
    head 
        title SIC43S1 Demonstration
    body(style='padding: 3em 0.75em; font: 14px "Lucida Grande", Helvetica, Arial, sans-serif;')
        h2 #{Title}
        table(style='width: 100%; margin: 0 auto;', border='1')
            tbody
                tr
                    th UID [7]
                    td(colspan="3") #{Uid}
                tr
                    th Default Key
                    td(colspan="3") #{Key}
                tr 
                    th 
                    th From Tag
                    th From Server
                    th Result
                if IsOcb
                    tr 
                        th Secured Authenticated Code (HEX)
                        td #{SAC}
                        td -
                        td -
                    tr 
                        th Time Stamp (DEC)
                        td #{TimeStamp}
                        td -
                        td -
                    tr 
                        th User Data (HEX)
                        td -
                        td #{UserData_s}
                        td -
                    tr
                        th Verified UID (HEX)
                        td #{Uid}
                        td #{Uid_s}
                        td #{Uid_status}
                    tr
                        th Temporary Flag (HEX)
                        td #{TemporaryFlag}
                        td #{TemporaryFlag_s}
                        td #{TemporaryFlag_status}
                else
                    tr 
                        th Temporary Flag (HEX)
                        td #{TemporaryFlag}
                        td -
                        td -
                    tr 
                        th Time Stamp (DEC)
                        td #{TimeStamp}
                        td -
                        td -
                    tr 
                        th Rolling code (HEX)
                        td #{SAC}
                        td #{SAC_s}
                        td #{SAC_status}